local function RefreshSpectateUI()
    if SpectatingTarget then
        SpectateBtn.Text = "👁️ ESPECTANDO: " .. SpectatingTarget.Name .. " (PARAR)"
        SpectateBtn.BackgroundColor3 = Color3.fromRGB(0, 132, 214)
    elseif SelectedPlayer then
        SpectateBtn.Text = "👁️ ESPECTAR (" .. SelectedPlayer.Name .. "): OFF"
        SpectateBtn.BackgroundColor3 = Color3.fromRGB(36, 74, 118)
    else
        SpectateBtn.Text = "👁️ ESPECTAR SELECIONADO: OFF"
        SpectateBtn.BackgroundColor3 = Color3.fromRGB(36, 74, 118)
    end
end

SpectateBtn.MouseButton1Click:Connect(function()
    if SpectatingTarget then
        StopSpectate()
        RefreshSpectateUI()
        TitleLabel.Text = "STATUS: Espectar desligado"
    else
        if not SelectedPlayer then
            TitleLabel.Text = "Selecione um jogador primeiro!"
            return
        end
        SpectatingTarget = SelectedPlayer
        RefreshSpectateUI()
        TitleLabel.Text = "ESPECTANDO: " .. SelectedPlayer.Name
    end
end)

local function RefreshPlayerList()
    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    for _, child in ipairs(SpectateListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, 0, 0, 32)
        pBtn.BackgroundColor3 = (SelectedPlayer == plr) and Color3.fromRGB(0, 120, 200) or Color3.fromRGB(30, 35, 44)
        pBtn.Text = "  👤 " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
        pBtn.TextColor3 = Color3.fromRGB(235, 240, 245)
        pBtn.Font = Enum.Font.GothamSemibold
        pBtn.TextSize = 12
        pBtn.TextXAlignment = Enum.TextXAlignment.Left
        pBtn.Parent = PlayerListFrame

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = pBtn

        pBtn.MouseButton1Click:Connect(function()
            SelectedPlayer = plr
            FuncTopInfo.Text = "Selecionado: " .. plr.Name
            RefreshPlayerList()
        end)

        local isSpec = (SpectatingTarget == plr)
        local sBtn = Instance.new("TextButton")
        sBtn.Size = UDim2.new(1, 0, 0, 30)
        sBtn.BackgroundColor3 = isSpec and Color3.fromRGB(0, 132, 214) or ((SelectedPlayer == plr) and Color3.fromRGB(42, 65, 92) or Color3.fromRGB(30, 35, 44))
        sBtn.Text = (isSpec and "  👁️ ESPECTANDO: " or "  👤 ") .. plr.DisplayName .. " (@" .. plr.Name .. ")"
        sBtn.TextColor3 = Color3.fromRGB(235, 240, 245)
        sBtn.Font = Enum.Font.GothamSemibold
        sBtn.TextSize = 11
        sBtn.TextXAlignment = Enum.TextXAlignment.Left
        sBtn.Parent = SpectateListFrame

        local sc = Instance.new("UICorner")
        sc.CornerRadius = UDim.new(0, 6)
        sc.Parent = sBtn

        sBtn.MouseButton1Click:Connect(function()
            SelectedPlayer = plr
            FuncTopInfo.Text = "Selecionado: " .. plr.Name
            if SpectatingTarget == plr then
                StopSpectate()
                TitleLabel.Text = "STATUS: Espectar desligado"
            else
                SpectatingTarget = plr
                TitleLabel.Text = "ESPECTANDO: " .. plr.Name
            end
            RefreshPlayerList()
        end)
    end

    RefreshSpectateUI()
end

Players.PlayerAdded:Connect(RefreshPlayerList)
