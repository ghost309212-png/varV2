    if SelectedPlayer == plr then
        SelectedPlayer = nil
        FuncTopInfo.Text = "Selecionado: Nenhum jogador"
    end
    if SpectatingTarget == plr then
        StopSpectate()
    end
    task.wait(0.1)
    RefreshPlayerList()
end)

