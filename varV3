local function SendChatMessage(msg)
    task.spawn(function()
        pcall(function()
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local channels = TextChatService:FindFirstChild("TextChannels")
                local rbxGeneral = channels and (channels:FindFirstChild("RBXGeneral") or channels:GetChildren()[1])
                if rbxGeneral then
                    rbxGeneral:SendAsync(msg)
                end
            else
                local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
                    chatEvents.SayMessageRequest:FireServer(msg, "All")
                end
            end
        end)
    end)
end

-- Placar: atualiza valores/remotes do jogo SEM mandar :m no chat
local function UpdateGameScore(teamType, delta, newValue)
    pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            local n = obj.Name:lower()
            if obj:IsA("RemoteEvent") and (n:find("score") or n:find("placar") or n:find("goal") or n:find("gol")) then
                obj:FireServer(teamType, newValue, delta)
            elseif obj:IsA("IntValue") or obj:IsA("NumberValue") then
                if teamType == "Home" and (n == "home" or n == "homescore" or n == "casa") then
                    obj.Value = newValue
                elseif teamType == "Away" and (n == "away" or n == "awayscore" or n == "visitante") then
                    obj.Value = newValue
                end
            end
        end
    end)
end

-- Cartões: vários nomes detectados
local YellowCardNames = {
    "yellow", "amarelo", "yellow card", "cartao amarelo", "cartão amarelo",
    "yellowcard", "yc", "card_yellow", "amarela", "advertencia"
}

local RedCardNames = {
    "red", "vermelho", "red card", "cartao vermelho", "cartão vermelho",
    "redcard", "rc", "card_red", "vermelha", "expulsao", "expulsão"
}

local function MatchesCardName(itemName, nameList)
    local lower = itemName:lower()
    for _, pattern in ipairs(nameList) do
        if lower:find(pattern, 1, true) then
            return true
        end
    end
    return false
end

local function EquipOrGetCard(cardType)
    local targetList = (cardType == "Yellow") and YellowCardNames or RedCardNames
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return false end

    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and MatchesCardName(item.Name, targetList) then
            return true
        end
    end

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and MatchesCardName(item.Name, targetList) then
                hum:EquipTool(item)
                return true
            end
        end
    end

    local containers = {ReplicatedStorage, game:GetService("StarterPack"), workspace}
    for _, container in ipairs(containers) do
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Tool") and MatchesCardName(obj.Name, targetList) then
                local clone = obj:Clone()
                clone.Parent = backpack or char
                task.wait(0.05)
                hum:EquipTool(clone)
                return true
            elseif (obj:IsA("ClickDetector") or obj:IsA("TouchTransmitter")) and obj.Parent and MatchesCardName(obj.Parent.Name, targetList) then
                if obj:IsA("ClickDetector") and fireclickdetector then
                    fireclickdetector(obj)
                elseif obj:IsA("TouchTransmitter") and firetouchinterest and char:FindFirstChild("HumanoidRootPart") then
                    firetouchinterest(char.HumanoidRootPart, obj.Parent, 0)
                    task.wait(0.05)
                    firetouchinterest(char.HumanoidRootPart, obj.Parent, 1)
                end
            end
        end
    end

    SendChatMessage(cardType == "Yellow" and ":give me yellow" or ":give me red")
    return false
end

local function GiveCardToSelected(cardType)
    if not SelectedPlayer then return end
    EquipOrGetCard(cardType)
    if cardType == "Yellow" then
        SendChatMessage(":m 🟨 CARTÃO AMARELO para " .. SelectedPlayer.Name .. "!")
    else
        SendChatMessage(":m 🟥 CARTÃO VERMELHO para " .. SelectedPlayer.Name .. "!")
    end
end

